<!doctype html>
<html lang="uk">
   <head>
      <meta charset="UTF-8" />

      <link rel="stylesheet" href="css/register.css" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title><%=title %></title>
   </head>
   <body>
      <div class="register-container">
         <div class="register-header">
            <div class="mine-icon">💣</div>
            <h1>Сапер</h1>
            <p>Створіть акаунт, щоб грати</p>
         </div>

         <form method="post" action="/register">
            <div class="form-group">
               <label for="nickname">Нікнейм</label>
               <input
                  type="text"
                  name="username"
                  placeholder="Ваш ігровий нік"
               />
            </div>

            <div class="form-group">
               <label for="email">Email</label>
               <input
                  type="email"
                  name="email"
                  placeholder="example@mail.com"
               />
            </div>

            <div class="form-group">
               <label for="password">Пароль</label>
               <input
                  type="password"
                  name="password"
                  placeholder="Мінімум 6 символів"
               />
            </div>

            <div class="form-group">
               <label for="confirm-password">Підтвердіть пароль</label>
               <input
                  type="password"
                  id="confirm-password"
                  placeholder="Повторіть пароль"
               />
            </div>

            <button type="submit" class="btn-register">Зареєструватися</button>
         </form>

         <div class="login-link">
            Вже є акаунт? <a href="/signup">Увійти</a>
         </div>

         <div class="decorations">
            <span>🚩</span>
            <span>💣</span>
            <span>1️⃣</span>
            <span>2️⃣</span>
            <span>🚩</span>
         </div>
      </div>
   </body>
</html>
